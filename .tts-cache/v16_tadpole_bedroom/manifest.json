    },
    {
      "globalBeatIndex": 16,
      "chapterNumber": 1,
      "chapterBeatIndex": 16,
      "narrationText": "Đêm đầu tiên dưới ánh đèn ngủ vàng dịu, tôi nằm ngắm bể nòng nọc im phăng phắc rồi mỉm cười chìm vào giấc ngủ thật ngon.",
      "voiceTone": "SLOW_EMOTIONAL",
