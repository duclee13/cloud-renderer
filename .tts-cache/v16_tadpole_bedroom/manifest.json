    },
    {
      "globalBeatIndex": 14,
      "chapterNumber": 1,
      "chapterBeatIndex": 14,
      "narrationText": "Cả 50 cái đuôi đen mảnh mai uốn lượn nhịp nhàng trong làn nước mát, trông hệt như những nốt nhạc nhỏ đang nhảy múa dưới kính.",
      "ttsText": "Cả năm mươi cái đuôi đen mảnh mai uốn lượn nhịp nhàng trong làn nước mát, trông hệt như những nốt nhạc nhỏ đang nhảy múa dưới kính.",
      "voiceTone": "CALM_STORY",
