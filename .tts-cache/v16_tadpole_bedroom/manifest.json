    },
    {
      "globalBeatIndex": 34,
      "chapterNumber": 3,
      "chapterBeatIndex": 2,
      "narrationText": "Ngay cạnh đầu giường, một chú ếch to khỏe nhất bất ngờ bật mạnh lên đẩy hé tấm nắp lưới mỏng đang đậy hờ trên miệng bể.",
