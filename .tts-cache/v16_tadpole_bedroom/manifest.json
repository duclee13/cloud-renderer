    },
    {
      "globalBeatIndex": 13,
      "chapterNumber": 1,
      "chapterBeatIndex": 13,
      "narrationText": "May mà tôi nhớ lời ông dặn dùng nước ao thay vì nước máy có clo, vì mang nòng nọc rất mỏng manh khi lọc oxy hòa tan.",
      "ttsText": "May mà tôi nhớ lời ông dặn dùng nước ao thay vì nước máy có cờ-lo, vì mang nòng nọc rất mỏng manh khi lọc ô-xy hòa tan.",
      "voiceTone": "CALM_STORY",
