    },
    {
      "globalBeatIndex": 8,
      "chapterNumber": 1,
      "chapterBeatIndex": 8,
      "narrationText": "Tôi hớn hở khệ nệ xách chiếc xô nước nặng trịch đi ngang qua sân, vừa đi vừa tủm tỉm cười một mình đầy tự hào.",
