    },
    {
      "globalBeatIndex": 7,
      "chapterNumber": 1,
      "chapterBeatIndex": 7,
      "narrationText": "Cẩn thận như một nhà sinh vật học thực thụ, tôi còn múc thêm đầy nước ao kèm mấy cọng rong xanh để tụi nó đỡ nhớ nhà.",
      "voiceTone": "CALM_STORY",
