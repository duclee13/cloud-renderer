    },
    {
      "globalBeatIndex": 21,
      "chapterNumber": 2,
      "chapterBeatIndex": 5,
      "narrationText": "Khoái chí quá, tôi lấy vội cuốn sổ tay ngồi vẽ lại từng thay đổi nhỏ mỗi ngày, cảm giác như đang sở hữu phòng thí nghiệm riêng.",
      "voiceTone": "CALM_STORY",
