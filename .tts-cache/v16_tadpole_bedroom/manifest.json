    },
    {
      "globalBeatIndex": 20,
      "chapterNumber": 2,
      "chapterBeatIndex": 4,
      "narrationText": "Đôi chân sau mọc trước giúp chúng đạp nước mạnh mẽ hơn hẳn, chuẩn bị sẵn sàng bộ lò xo cho những cú nhảy sau này.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.408,
