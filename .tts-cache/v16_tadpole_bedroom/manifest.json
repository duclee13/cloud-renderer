      "chapterNumber": 3,
      "chapterBeatIndex": 3,
      "narrationText": "Chỉ chờ có thế, từng chú ếch xanh nối đuôi nhau nhảy phóc qua thành kính, đáp xuống mặt bàn rồi tản ra khắp căn phòng tối.",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.615,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 361,
      "cacheFile": "290744fbdbaf8e82d23a28a36f03.mp3"
    },
    {
      "globalBeatIndex": 36,
      "chapterNumber": 3,
      "chapterBeatIndex": 4,
      "narrationText": "Chưa đầy vài phút, mấy chục bóng xanh nhỏ đã bám kín từ rèm cửa sổ, mặt kính cho tới chao đèn ngủ và góc tủ gỗ.",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.76,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 370,
      "cacheFile": "62e5eae789327255a9196b9c70f5.mp3"
    },
    {
      "globalBeatIndex": 37,
      "chapterNumber": 3,
      "chapterBeatIndex": 5,
      "narrationText": "Bỗng một tiếng kêu giòn tan vang lên trong bóng tối: Ộp! Ngay lập tức hàng chục giọng khác bên tường và bàn học rộn ràng đáp lại.",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.687,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 366,
      "cacheFile": "0839805c257d869624f0d050767c.mp3"
    },
    {
      "globalBeatIndex": 38,
      "chapterNumber": 3,
      "chapterBeatIndex": 6,
      "narrationText": "Bí mật là chiếc túi thanh quản dưới cổ ếch: nó phồng căng như quả bóng nhỏ giúp tiếng kêu khuếch đại vang rền cả phòng.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.454,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 352,
      "cacheFile": "dcd51dc06fb1fac4a4e4cfd75273.mp3"
    },
    {
      "globalBeatIndex": 39,
      "chapterNumber": 3,
      "chapterBeatIndex": 7,
      "narrationText": "Giữa dàn hợp xướng Ộp Oạp vang trời ấy, tôi vẫn đang mơ màng kéo chăn trùm tai mà tưởng ngoài ao có dàn nhạc nào đang tập.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.767,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 371,
      "cacheFile": "7e7ce683a149a9a63393299fea89.mp3"
    },
    {
      "globalBeatIndex": 40,
      "chapterNumber": 3,
      "chapterBeatIndex": 8,
      "narrationText": "Bỗng \"BỘP!\" một cái, thứ gì đó mát lạnh và ẩm ướt nhảy thẳng lên đúng chóp mũi khiến tôi giật bắn người hét toáng lên!",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.688,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 366,
      "cacheFile": "f623e1890bfdc28a429ce012afaa.mp3"
    },
    {
      "globalBeatIndex": 41,
      "chapterNumber": 3,
      "chapterBeatIndex": 9,
      "narrationText": "Mở mắt ra tôi muốn xỉu tại chỗ: hàng chục chú ếch xanh đang nhảy tưng tưng khắp phòng, tiếng Ộp Oạp rền vang như lễ hội!",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.649,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 363,
      "cacheFile": "dd00ed2352f3cd321140db0d097e.mp3"
    },
    {
      "globalBeatIndex": 42,
      "chapterNumber": 3,
      "chapterBeatIndex": 10,
      "narrationText": "Cặp chân sau gập như lò xo cho phép một chú ếch nhỏ bật xa gấp nhiều lần chiều dài cơ thể chỉ trong chớp mắt.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.378,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 347,
      "cacheFile": "c09cb5dea8d1e736f1123b6e3bc7.mp3"
    },
    {
      "globalBeatIndex": 43,
      "chapterNumber": 3,
      "chapterBeatIndex": 11,
      "narrationText": "Tôi cuống cuồng bật dậy khua tay đuổi bắt, vừa thò tay vồ con trên gối thì hai con khác đã nhảy phóc qua đầu sang bàn học.",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 6.1,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 391,
      "cacheFile": "a254b60ca4aa41a2e72fe6473efe.mp3"
    },
    {
      "globalBeatIndex": 44,
      "chapterNumber": 3,
      "chapterBeatIndex": 12,
      "narrationText": "Đúng lúc căn phòng hỗn loạn nhất, ngoài hành lang bỗng vang lên tiếng dép lẹt xẹt vội vã của ông nội nghe tiếng la chạy sang.",
      "voiceTone": "STEP_BY_STEP_SUSPENSE",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.306,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 343,
      "cacheFile": "dfea4cabce399b7c8c4eca4d591d.mp3"
    },
    {
      "globalBeatIndex": 45,
      "chapterNumber": 3,
      "chapterBeatIndex": 13,
      "narrationText": "Cạch! Ông nội đẩy cửa bật sáng trưng bóng đèn trần, rồi đứng khựng lại như trời trồng trước khung cảnh ếch đậu kín cả phòng ngủ!",
      "voiceTone": "TENSE_CLIMAX",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 6.202,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 397,
      "cacheFile": "6224edde3d195555483daa712aeb.mp3"
    },
    {
      "globalBeatIndex": 46,
      "chapterNumber": 3,
      "chapterBeatIndex": 14,
      "narrationText": "Một chú ếch còn ung dung ngồi chễm chệ ngay trên chao đèn ngủ, phồng má kêu \"Ộp!\" một tiếng rõ to như gửi lời chào ông nội.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.884,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 378,
      "cacheFile": "32cca137079d29cece1f0757a5c6.mp3"
    },
    {
      "globalBeatIndex": 47,
      "chapterNumber": 3,
      "chapterBeatIndex": 15,
      "narrationText": "Hai ông cháu nhìn nhau mất mấy giây im phăng phắc, rồi ông bật cười lắc đầu hỏi lại chuyện \"thú cưng im re\" hôm nào của tôi.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.463,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 352,
      "cacheFile": "b24213dd70c4941459aea84168e5.mp3"
    },
    {
      "globalBeatIndex": 48,
      "chapterNumber": 3,
      "chapterBeatIndex": 16,
      "narrationText": "Thế là hai ông cháu đành thức trắng nửa đêm, kẻ cầm vợt người cầm xô nhẹ nhàng lùa bắt từng vận động viên nhảy xa trốn trong góc.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.936,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 381,
      "cacheFile": "b5050d62f6045a3bdc8e5ba8a283.mp3"
    },
    {
      "globalBeatIndex": 49,
      "chapterNumber": 4,
      "chapterBeatIndex": 1,
      "narrationText": "Sau gần một tiếng bò quanh gầm giường với gầm bàn, cuối cùng chiếc xô lưới cũng gom đủ từng chú ếch xanh tròn mắt ngơ ngác.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.602,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 361,
      "cacheFile": "aff7ae8ddebb0db81c5307a60162.mp3"
    },
    {
      "globalBeatIndex": 50,
      "chapterNumber": 4,
      "chapterBeatIndex": 2,
      "narrationText": "Ngoài cửa sổ trời vừa hửng nắng sớm, nhìn lũ ếch cứ rướn người nhảy lên thành xô là tôi hiểu ngay tụi nó nhớ ao.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.577,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 359,
      "cacheFile": "b245283c3d560726faf9ca549563.mp3"
    },
    {
      "globalBeatIndex": 51,
      "chapterNumber": 4,
      "chapterBeatIndex": 3,
      "narrationText": "Hai ông cháu không ngủ nữa mà xách luôn chiếc xô đi dọc bờ rào gỗ, thẳng hướng ao sen xanh mát phía sau vườn nhà.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.382,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 347,
      "cacheFile": "f7d432163cb299afa19a7e8dd4d4.mp3"
    },
    {
      "globalBeatIndex": 52,
      "chapterNumber": 4,
      "chapterBeatIndex": 4,
      "narrationText": "Ra tới bờ ao, làn gió sáng thơm mùi lá sen thoang thoảng làm cả đám ếch trong xô bỗng rộn ràng nhảy lách tách hẳn lên.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.468,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 353,
      "cacheFile": "c0f60bc841a1e08013426f1c136e.mp3"
    },
    {
      "globalBeatIndex": 53,
      "chapterNumber": 4,
      "chapterBeatIndex": 5,
      "narrationText": "Hai ông cháu cùng ngồi xuống mép cỏ, từ từ nghiêng chiếc xô cho cả đàn ếch con tung mình nhảy ùm xuống mặt nước ao sen!",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.544,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 357,
      "cacheFile": "edcfa2f3b25be21bb53c69cc1086.mp3"
    },
    {
      "globalBeatIndex": 54,
      "chapterNumber": 4,
      "chapterBeatIndex": 6,
      "narrationText": "Hàng chục vòng sóng tròn lan rộng khắp mặt ao, lũ ếch xanh hớn hở bơi tản ra rồi trèo tót lên những chiếc lá sen rung rinh.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 6.334,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 405,
      "cacheFile": "9543db191e6b46b0705eec011266.mp3"
    },
    {
      "globalBeatIndex": 55,
      "chapterNumber": 4,
      "chapterBeatIndex": 7,
      "narrationText": "Tôi vẫy tay chào những người bạn cùng phòng đặc biệt nhất mùa hè, thấy một chú ngồi trên cánh sen còn quay lại kêu một tiếng.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.613,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 361,
      "cacheFile": "1015cfd0df6d76ff62fe884be5c5.mp3"
    },
    {
      "globalBeatIndex": 56,
      "chapterNumber": 4,
      "chapterBeatIndex": 8,
      "narrationText": "Ông nội vỗ vai tôi mỉm cười kể rằng đám ếch này sắp trở thành đội bảo vệ cực kỳ đắc lực cho cả khu vườn nhà ông.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.645,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 363,
      "cacheFile": "88a915154c5f54f9deea1e026954.mp3"
    },
    {
      "globalBeatIndex": 57,
      "chapterNumber": 4,
      "chapterBeatIndex": 9,
      "narrationText": "Chỉ bằng chiếc lưỡi dính bật ra nhanh như chớp, mỗi chú ếch xanh có thể bắt gọn hàng loạt muỗi và sâu bọ bay quanh mặt ao.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.967,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 383,
      "cacheFile": "b505ef3bd5ec3ae2bc432ced8ac6.mp3"
    },
    {
      "globalBeatIndex": 58,
      "chapterNumber": 4,
      "chapterBeatIndex": 10,
      "narrationText": "Chiều hôm đó ra hóng mát dưới ánh hoàng hôn vàng ươm, quả nhiên quanh ao vắng hẳn tiếng muỗi vo ve như mấy hôm trước.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.222,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 338,
      "cacheFile": "2f7f80b04639e22c22a798f58af5.mp3"
    },
    {
      "globalBeatIndex": 59,
      "chapterNumber": 4,
      "chapterBeatIndex": 11,
      "narrationText": "Về lại phòng ngủ, tôi rửa sạch chiếc bể kính đặt gọn gàng lên kệ, tuy hơi trống trải nhưng nhìn phòng sạch bóng lại thấy nhẹ nhõm.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 6.335,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 405,
      "cacheFile": "bfcbf95bcee38a08ae250c50bcf5.mp3"
    },
    {
      "globalBeatIndex": 60,
      "chapterNumber": 4,
      "chapterBeatIndex": 12,
      "narrationText": "Tôi mở cuốn sổ tay ra ngắm lại mấy bức tranh vẽ nòng nọc mọc chân nguệch ngoạc, tự dưng thấy mùa hè năm đó thú vị lạ thường.",
      "voiceTone": "SLOW_EMOTIONAL",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.888,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 378,
      "cacheFile": "9e1184fe88d17b56bfa83f3d8ac9.mp3"
    },
    {
      "globalBeatIndex": 61,
      "chapterNumber": 4,
      "chapterBeatIndex": 13,
      "narrationText": "Đêm đó tôi đặt lưng xuống gối là ngủ một mạch ngon lành tới sáng, không còn bàn chân mát lạnh nào nhảy trúng mũi nữa.",
      "voiceTone": "SLOW_EMOTIONAL",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.155,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 334,
      "cacheFile": "5a48d1697e81e190a66a04dc151b.mp3"
    },
    {
      "globalBeatIndex": 62,
      "chapterNumber": 4,
      "chapterBeatIndex": 14,
      "narrationText": "Phía xa ngoài ao sen lung linh ánh trăng, tiếng Ộp Oạp lúc này nghe dịu dàng êm tai hệt như một bản nhạc ru ngủ mùa hè.",
      "voiceTone": "SLOW_EMOTIONAL",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.478,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 353,
      "cacheFile": "e5106505ea03a82741b11bf612ac.mp3"
    },
    {
      "globalBeatIndex": 63,
      "chapterNumber": 4,
      "chapterBeatIndex": 15,
      "narrationText": "Từ hồi ấy tôi mới vỡ lẽ: ngắm thế giới tự nhiên lớn lên ngay tại ngôi nhà vốn có của chúng luôn đẹp hơn nhốt trong bể.",
      "voiceTone": "SLOW_EMOTIONAL",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.594,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 360,
      "cacheFile": "f62adefbcbf6c97e1e86965343ee.mp3"
    },
    {
      "globalBeatIndex": 64,
      "chapterNumber": 4,
      "chapterBeatIndex": 16,
      "narrationText": "Còn bạn thì sao, hồi nhỏ bạn đã từng lén đem sinh vật kỳ lạ nào về phòng nuôi chưa? Kể cho tôi nghe với nhé!",
      "voiceTone": "SLOW_EMOTIONAL",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.327,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 344,
      "cacheFile": "9b3cc2bf542ea0a1a3b4dbfe6872.mp3"
    }
  ]
}