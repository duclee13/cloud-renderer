      "actualDurationSec": 5.88,
      "pauseAfterSec": 0.4,
      "totalDurationFrames": 377,
      "cacheFile": "989b460f31dc21a68537b91716d3.mp3"
    },
    {
      "globalBeatIndex": 32,
      "chapterNumber": 2,
      "chapterBeatIndex": 16,
      "narrationText": "Tối hôm đó buồn ngủ ríu cả mắt, tôi đặt hờ tấm nắp lưới cho thoáng khí rồi leo lên giường đắp chăn ngủ say như chết.",
