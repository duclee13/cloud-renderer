    },
    {
      "globalBeatIndex": 11,
      "chapterNumber": 1,
      "chapterBeatIndex": 11,
      "narrationText": "Vào tới phòng ngủ, tôi dọn sạch chiếc bàn gỗ kê ngay cạnh đầu giường rồi đặt chiếc bể kính cũ lên đó thật ngay ngắn.",
      "voiceTone": "CALM_STORY",
      "voiceName": "Hải Đăng",
      "actualDurationSec": 5.039,
