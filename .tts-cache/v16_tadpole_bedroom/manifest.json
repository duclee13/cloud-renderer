    },
    {
      "globalBeatIndex": 12,
      "chapterNumber": 1,
      "chapterBeatIndex": 12,
      "narrationText": "Tôi từ từ nghiêng xô đổ nhẹ cả đàn nòng nọc cùng đám rong xanh vào bể, nhìn từng chú nhỏ ùa ra tung tăng khám phá.",
      "voiceTone": "CALM_STORY",
