    },
    {
      "globalBeatIndex": 10,
      "chapterNumber": 1,
      "chapterBeatIndex": 10,
      "narrationText": "Tôi giơ cao xô khoe ngay với ông rằng đây là đàn thú cưng yên tĩnh nhất thế giới, chắc chắn chẳng bao giờ ồn ào.",
      "voiceTone": "CALM_STORY",
