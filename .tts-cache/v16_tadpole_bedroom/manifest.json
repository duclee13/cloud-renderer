    },
    {
      "globalBeatIndex": 6,
      "chapterNumber": 1,
      "chapterBeatIndex": 6,
      "narrationText": "Chỉ vài cú vớt mà chiếc xô nhựa xanh đã chật ních, tôi đếm sơ sơ cũng phải hơn 50 chú nòng nọc đen nhánh.",
      "ttsText": "Chỉ vài cú vớt mà chiếc xô nhựa xanh đã chật ních, tôi đếm sơ sơ cũng phải hơn năm mươi chú nòng nọc đen nhánh.",
      "voiceTone": "CALM_STORY",
