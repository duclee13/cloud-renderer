    },
    {
      "globalBeatIndex": 18,
      "chapterNumber": 2,
      "chapterBeatIndex": 2,
      "narrationText": "Hai bên gốc đuôi của mấy chú nòng nọc to nhất bất ngờ nhú ra đôi chân sau tí hon đang co duỗi cực kỳ linh hoạt!",
