# ============================================================================
# 1. GITHUB API CONFIGURATION (BẮT BUỘC TRÊN VERCEL)
# ============================================================================
# GitHub Personal Access Token có quyền trên repo duclee13/cloud-renderer:
# - Actions: Read and write (kích hoạt workflow_dispatch, đọc runs/jobs/artifacts, cancel)
# - Contents: Read-only (đọc danh sách web-studio/episodes/*.json)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

GITHUB_OWNER=duclee13
GITHUB_REPO=cloud-renderer
GITHUB_BRANCH=main

# ============================================================================
# 2. SECURITY SECRETS
# ============================================================================
# Mã PIN bảo vệ nút Run Cloud Render & Cancel trên giao diện web (để trống nếu tắt PIN)
DASHBOARD_PIN=123456

# Khóa bí mật xác thực gói tin telemetry từ 16–20 máy ảo GitHub Actions gửi về /api/vm-progress
# (Phải trùng khớp với GitHub Actions Secret: DASHBOARD_PROGRESS_SECRET)
PROGRESS_SECRET=replace_with_a_strong_random_secret

# ============================================================================
# 3. UPSTASH REDIS REST API (CHO TELEMETRY MỨC 2: % FRAME, FPS, ETA TỪNG VM)
# ============================================================================
# Nếu bỏ trống 2 biến dưới đây, Dashboard tự động bỏ qua Redis và fallback sạch về GitHub Jobs API.
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ============================================================================
# GHI CHÚ CẤU HÌNH BÊN GITHUB REPO SECRETS (duclee13/cloud-renderer):
# - DASHBOARD_PROGRESS_URL = https://ten-domain-cua-ban.vercel.app/api/vm-progress
# - DASHBOARD_PROGRESS_SECRET = <giá trị giống hệt PROGRESS_SECRET ở trên>
# ============================================================================
